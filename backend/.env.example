DATABASE_URL=postgresql+asyncpg://monitor:monitor@localhost:5433/monitor
SQL_ECHO=false
REQUEST_TIMEOUT_SECONDS=10
MAX_CONCURRENT_CHECKS=50
MIN_CHECK_INTERVAL_SECONDS=5
SCHEDULER_INITIAL_JITTER_SECONDS=5
RAW_LOG_RETENTION_DAYS=14
AGGREGATE_RETENTION_DAYS=30
MAINTENANCE_INTERVAL_SECONDS=300
SEED_DEMO_TARGETS=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
